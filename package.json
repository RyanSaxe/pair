{
  "name": "@ryansaxe/pair",
  "version": "0.0.0-development",
  "description": "Work with an agent in the browser: plan a change, build it, and explain it.",
  "license": "MIT",
  "author": "Ryan Saxe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanSaxe/pair.git"
  },
  "homepage": "https://github.com/RyanSaxe/pair#readme",
  "bugs": {
    "url": "https://github.com/RyanSaxe/pair/issues"
  },
  "type": "module",
  "bin": {
    "pair": "src/cli.mjs"
  },
  "imports": {
    "#frame/*": "./src/frame/*",
    "#shared/*": "./src/shared/*"
  },
  "engines": {
    "node": ">=20.1.0"
  },
  "files": [
    "src",
    "guide",
    "adapters",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "test:browser": "node --test tests/browser/*.browser.mjs",
    "test:figures": "node --test tests/browser/figures.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
